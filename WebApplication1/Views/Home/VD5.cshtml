<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <script language="JavaScript">
        function Respond()
        {
            var check = document.getElementsByName("uni");
            if (check[0].checked == true) {
                document.getElementById("huflit").innerHTML ="Toi la sinh vien CNTT, Truong Huflit";
            }
            if (check[1].checked == true) {
                document.getElementById("huflit").innerHTML = "Toi ko la sinh vien CNTT, Truong Huflit";
            }
            
        }
    </script>
</head>
<body>
    <h4> Ban co phai la sinh vien khoa CNTT, Truong Huflit khong?</h4>

        <input type ="radio" name="uni" value="yes" /> Phai
        <br />
        <input type="radio" name="uni" value="no" /> Khong phai
        <br />
        <input type="submit" value="Tra loi" onclick="Respond();" />
        <br />
        <p id="huflit"></p>
    
</body>
</html>
